NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/roomly

# Only set to true on a Mongo-compatible DB without TTL support (e.g. FerretDB). Real MongoDB: leave unset.
# DISABLE_TTL_INDEX=true

# Auth — use a long random string in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d

# Browser origins allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:5173

# Public base URL of this API (used to build receipt image links)
PUBLIC_URL=http://localhost:5000
UPLOAD_DIR=./uploads

# Month boundaries and "today" are computed in this timezone
APP_TIMEZONE=Asia/Kolkata

# Optional SMTP for password-reset emails. Without it, reset links are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Roomly <no-reply@roomly.app>"
CLIENT_URL=http://localhost:5173

# Google OAuth client credentials. The redirect path must be /api/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# ---------------------------------------------------------------------------
# WhatsApp Cloud API (Meta) — leave blank to run without WhatsApp.
# Setup steps are in README.md → "WhatsApp setup". Check them with:  npm run whatsapp:doctor
# ---------------------------------------------------------------------------
# Permanent System User access token (temporary tokens expire in ~24h)
WHATSAPP_ACCESS_TOKEN=
# "Phone number ID" from WhatsApp → API Setup (NOT the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=
# App secret from App settings → Basic. Used to verify the webhook signature.
WHATSAPP_APP_SECRET=
# Any long random string you invent; paste the same value into Meta's webhook setup.
WHATSAPP_VERIFY_TOKEN=
# The bot's number in international digits, e.g. 919876543210 (for wa.me links and the QR code)
WHATSAPP_DISPLAY_NUMBER=
WHATSAPP_GRAPH_VERSION=v23.0
# Groups API: needs an Official Business Account (see README). Leave false unless you have one.
WHATSAPP_GROUPS_ENABLED=false
# LOCAL DEVELOPMENT ONLY: fake incoming messages without Meta. The server refuses to start with this on in production.
WHATSAPP_SIMULATOR=false
